---
import BaseLayout from "./BaseLayout.astro";

type Frontmatter = {
  title: string;
  description: string;
  date: string;
  lang: "ja" | "en";
};

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };

const base = import.meta.env.BASE_URL;
const isJa = frontmatter.lang === "ja";

const homeLink = `${base}${isJa ? "ja/" : "en/"}`;
const blogLink = `${base}${isJa ? "ja/blog/" : "en/blog/"}`;

const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const slug = pathParts[pathParts.length - 1] ?? "";
const altLink = `${base}${isJa ? "en" : "ja"}/blog/${slug}/`;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  lang={isJa ? "ja" : "en"}
  homeLink={homeLink}
  homeLabel="Home"
  blogLink={blogLink}
  blogLabel="Blog"
  altLink={altLink}
  currentSection="blog"
>
  <p>
    <a href={blogLink}>
      {isJa ? "← ブログ一覧に戻る" : "← Back to blog"}
    </a>
  </p>

  <h1>{frontmatter.title}</h1>
  <p>{frontmatter.date} · {frontmatter.description}</p>

  <slot />
</BaseLayout>