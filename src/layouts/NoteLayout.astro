---
import BaseLayout from "./BaseLayout.astro";

type Frontmatter = {
  title: string;
  description: string;
  date: string;
  lang: "ja" | "en";
};

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };

const base = import.meta.env.BASE_URL;
const isJa = frontmatter.lang === "ja";

const homeLink = `${base}${isJa ? "ja/" : "en/"}`;
const blogLink = `${base}${isJa ? "ja/blog/" : "en/blog/"}`;

const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const slug = pathParts[pathParts.length - 1] ?? "";
const altLink = `${base}${isJa ? "en" : "ja"}/blog/${slug}/`;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  lang={isJa ? "ja" : "en"}
  homeLink={homeLink}
  homeLabel={isJa ? "プロフィール" : "Profile"}
  blogLink={blogLink}
  blogLabel={isJa ? "ブログ" : "Blog"}
  altLink={altLink}
  currentSection="blog"
>
  <main class="main-panel">
    <p>
      <a href={blogLink}>
        {isJa ? "← ブログ一覧に戻る" : "← Back to blog"}
      </a>
    </p>

    <div class="article-header">
      <h1 class="article-title">{frontmatter.title}</h1>
      <div class="article-meta">{frontmatter.date} · {frontmatter.description}</div>
    </div>

    <div class="article-content">
      <slot />
    </div>
  </main>
</BaseLayout>
