---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "ja" | "en";
  homeLink: string;
  homeLabel: string;
  blogLink?: string;
  blogLabel?: string;
  altLink?: string;
  altLabel?: string;
  currentSection?: "home" | "blog";
}

const {
  title,
  description,
  lang,
  homeLink,
  homeLabel,
  blogLink,
  blogLabel,
  altLink,
  altLabel,
  currentSection,
} = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={homeLink}>
          <img src={`${import.meta.env.BASE_URL}avatar.svg`} alt="Ryoki Endo" />
          <div class="site-brand-text">
            <div class="site-brand-title">Ryoki Endo</div>
            <div class="site-brand-subtitle">
              {lang === "ja"
                ? "Mathematics / Spectral Geometry"
                : "Mathematics / Spectral Geometry"}
            </div>
          </div>
        </a>

        <div class="header-controls">
          <nav class="site-nav" aria-label={lang === "ja" ? "主要メニュー" : "Main navigation"}>
            <a
              class={`nav-tab ${currentSection === "home" ? "is-active" : ""}`}
              href={homeLink}
              aria-current={currentSection === "home" ? "page" : undefined}
            >
              {homeLabel}
            </a>

            {blogLink && blogLabel && (
              <a
                class={`nav-tab ${currentSection === "blog" ? "is-active" : ""}`}
                href={blogLink}
                aria-current={currentSection === "blog" ? "page" : undefined}
              >
                {blogLabel}
              </a>
            )}
          </nav>

          {altLink && altLabel && (
            <div class="lang-toggle" aria-label={lang === "ja" ? "言語切替" : "Language switch"}>
              <span class={`lang-toggle-item is-current`}>
                {lang === "ja" ? "日本語" : "English"}
              </span>
              <a class="lang-toggle-item" href={altLink}>
                {altLabel}
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <span>© Ryoki Endo</span>
        <span>{lang === "ja" ? "個人研究ページ" : "Personal academic website"}</span>
      </div>
    </footer>
  </body>
</html>