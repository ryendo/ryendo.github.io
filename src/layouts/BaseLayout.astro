---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "ja" | "en";
  homeLink: string;
  homeLabel: string;
  blogLink?: string;
  blogLabel?: string;
  altLink?: string;
  altLabel?: string;
  currentSection?: "home" | "blog";
}

const {
  title,
  description,
  lang,
  homeLink,
  homeLabel,
  blogLink,
  blogLabel,
  altLink,
  altLabel,
  currentSection,
} = Astro.props as Props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={homeLink}>
          {lang === "ja" ? "遠藤 凌輝" : "Ryoki Endo"}
        </a>

        <div class="header-right">
          <a
            href={homeLink}
            class={currentSection === "home" ? "is-active" : ""}
          >
            {homeLabel}
          </a>

          {blogLink && blogLabel && (
            <a
              href={blogLink}
              class={currentSection === "blog" ? "is-active" : ""}
            >
              {blogLabel}
            </a>
          )}

          {altLink && (
            <>
              <span class="lang-sep">|</span>
              <a href={altLink}>{altLabel}</a>
            </>
          )}
        </div>
      </div>
    </header>

    <slot />

    <footer class="footer">
      <span>&copy; Ryoki Endo</span>
    </footer>
  </body>
</html>
