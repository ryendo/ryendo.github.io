---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { profileEn } from "../../../data/profile";

const profile = profileEn;
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Notes | Ryoki Endo"
  description="Mathematical notes written in Markdown with KaTeX"
  lang="en"
  homeLink={`${base}en/`}
  homeLabel="Profile"
  notesLink={`${base}en/notes/`}
  notesLabel="Notes"
  altLink={`${base}ja/notes/`}
  altLabel="日本語"
>
  <main class="main-panel" style="margin-top: 1rem;">
    <section class="section-card">
      <h1>Notes</h1>
      <p>This is a small notes section powered by Markdown and KaTeX. Add new notes as Markdown files under src/pages/en/notes/.</p>
      <div class="note-list">
        {profile.notes.map((note) => (
          <a href={`${base}${note.url.replace(/^\//, "")}`}>
            <div class="note-card">
              <h3>{note.title}</h3>
              <p>{note.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
