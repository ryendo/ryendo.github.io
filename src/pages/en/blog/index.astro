---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Blog | Ryoki Endo"
  description="Blog posts by Ryoki Endo"
  lang="en"
  homeLink={`${base}en/`}
  homeLabel="Profile"
  blogLink={`${base}en/blog/`}
  blogLabel="Blog"
  altLink={`${base}ja/blog/`}
  altLabel="日本語"
  currentSection="blog"
>
  <main class="main-panel">
    <section class="section-card">
      <h1 class="section-title">Blog</h1>
      <p>Short updates, research notes, announcements, and seminar or travel reports.</p>

      <div class="card-list" style="margin-top: 1rem;">
        <a href={`${base}en/blog/first-post/`}>
          <article class="item-card">
            <h3>First post</h3>
            <p>A sample blog entry. Replace this with your own post.</p>
          </article>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>