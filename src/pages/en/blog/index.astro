---
import BaseLayout from "../../../layouts/BaseLayout.astro";

type Post = {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    date: string;
  };
};

const base = import.meta.env.BASE_URL;
const homeLink = `${base}en/`;
const blogLink = `${base}en/blog/`;
const altLink = `${base}ja/blog/`;

const posts = ((await Astro.glob("./*.md")) as Post[]).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout
  title="Blog"
  description="Short updates, research notes, announcements, and seminar or travel reports"
  lang="en"
  homeLink={homeLink}
  homeLabel="Profile"
  blogLink={blogLink}
  blogLabel="Blog"
  altLink={altLink}
  currentSection="blog"
>
  <main class="main-panel">
    <h1>Blog</h1>
    <p class="muted">Short updates, research notes, announcements, and seminar or travel reports.</p>

    <ul class="blog-list">
      {posts.map((post) => (
        <li>
          <a href={post.url}>{post.frontmatter.title}</a>
          <div class="desc">{post.frontmatter.description}</div>
          <div class="date">{post.frontmatter.date}</div>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
