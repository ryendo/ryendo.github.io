---
import BaseLayout from "../../../layouts/BaseLayout.astro";

type Post = {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    date: string;
  };
};

const base = import.meta.env.BASE_URL;
const homeLink = `${base}en/`;
const blogLink = `${base}en/blog/`;
const altLink = `${base}ja/blog/`;

const posts = ((await Astro.glob("./*.md")) as Post[]).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout
  title="Blog"
  description="Short updates, research notes, announcements, and seminar or travel reports"
  lang="en"
  homeLink={homeLink}
  homeLabel="Home"
  blogLink={blogLink}
  blogLabel="Blog"
  altLink={altLink}
  currentSection="blog"
>
  <h1>Blog</h1>

  <p>Short updates, research notes, announcements, and seminar or travel reports.</p>

  <ul>
    {posts.map((post) => (
      <li>
        <a href={post.url}>{post.frontmatter.title}</a>
        {" — "}
        {post.frontmatter.description}
        {" ("}
        {post.frontmatter.date}
        {")"}
      </li>
    ))}
  </ul>
</BaseLayout>