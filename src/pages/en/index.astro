---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profileEn, siteInfo } from "../../data/profile";

const profile = profileEn;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Ryoki Endo"
  description=""
  lang="en"
  homeLink={`${base}en/`}
  homeLabel="Profile"
  blogLink={`${base}en/blog/`}
  blogLabel="Blog"
  altLink={`${base}ja/`}
  altLabel="日本語"
  currentSection="home"
>
  <main class="main-panel">
    <section class="section-card">
      <h1 class="hero-title">{profile.heroTitle}</h1>
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </section>

      <div class="profile-main">
        <div class="section-stack">

          <section id="keywords" class="section-card anchor-offset">
            <h2 class="section-title">Keywords</h2>
            <div class="hero-meta">
              {profile.keywords.map((keyword) => (
                <span class="tag">{keyword}</span>
              ))}
            </div>
          </section>

          <section id="degrees" class="section-card anchor-offset">
            <h2 class="section-title">Degrees</h2>
            <div class="info-list">
              {profile.degrees.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.en}</div>
                  <div class="info-item-meta">{item.when}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="awards" class="section-card anchor-offset">
            <h2 class="section-title">Awards</h2>
            <div class="info-list">
              {profile.awards.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.label}</div>
                  <div class="info-item-meta">{item.year}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="papers" class="section-card anchor-offset">
            <h2 class="section-title">Papers</h2>
            <div class="card-list">
              {profile.publications.map((paper) => (
                <article class="item-card">
                  <h3>{paper.title}</h3>
                  <p>{paper.authors}</p>
                  <p class="muted">{paper.venue}</p>
                  <div class="hero-meta" style="margin-top: 0.8rem;">
                    <span class="meta-chip">{paper.when}</span>
                    <span class="meta-chip">{paper.note}</span>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section id="talks-ja" class="section-card anchor-offset">
            <h2 class="section-title">Talks in Japanese</h2>
            <div class="card-list">
              {profile.talksJapanese.map((talk) => (
                <article class="item-card">
                  <h3>{talk.title}</h3>
                  {talk.authors && <p>Speaker(s): {talk.authors}</p>}
                  <p>{talk.event}</p>
                  <p class="muted">
                    {talk.date}
                    {talk.note ? ` · ${talk.note}` : ""}
                  </p>
                </article>
              ))}
            </div>
          </section>

          <section id="talks-en" class="section-card anchor-offset">
            <h2 class="section-title">Talks in English</h2>
            <div class="card-list">
              {profile.talksEnglish.map((talk) => (
                <article class="item-card">
                  <h3>{talk.title}</h3>
                  {talk.authors && <p>Speaker(s): {talk.authors}</p>}
                  <p>{talk.event}</p>
                  <p class="muted">
                    {talk.date}
                    {talk.note ? ` · ${talk.note}` : ""}
                  </p>
                </article>
              ))}
            </div>
          </section>

          <section id="societies" class="section-card anchor-offset">
            <h2 class="section-title">Academic Societies</h2>
            <div class="info-list">
              {profile.memberships.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.en}</div>
                  <div class="info-item-meta">{item.period}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="grants" class="section-card anchor-offset">
            <h2 class="section-title">Grants</h2>
            <div class="card-list">
              {profile.grants.map((item) => (
                <article class="item-card">
                  <h3>{item.en}</h3>
                  <p>{item.funding}</p>
                  <p class="muted">{item.period}</p>
                </article>
              ))}
            </div>
          </section>

          <section id="links" class="section-card anchor-offset">
            <h2 class="section-title">Links</h2>
            <div class="inline-links">
              <a href={siteInfo.researchmap} target="_blank" rel="noreferrer">
                researchmap
              </a>
              <a href={siteInfo.orcid} target="_blank" rel="noreferrer">
                ORCID
              </a>
            </div>

            <div class="info-list" style="margin-top: 1rem;">
              <div class="info-item">
                <div class="info-item-title">Researcher ID</div>
                <div class="info-item-meta">{siteInfo.researcherNumber}</div>
              </div>
              <div class="info-item">
                <div class="info-item-title">Contact</div>
                <div class="info-item-meta">{siteInfo.emailDisplay}</div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>