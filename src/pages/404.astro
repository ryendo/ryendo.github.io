---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="404"
  description="Page not found"
  lang="en"
  homeLink={base}
  homeLabel="Home"
  altLink={`${base}ja/`}
  altLabel="日本語"
>
  <main class="main-panel">
    <h1>404</h1>
    <p>The page was not found.</p>
    <p><a href={`${base}en/`}>Go to English profile</a> / <a href={`${base}ja/`}>日本語プロフィールへ</a></p>
  </main>
</BaseLayout>
