---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";

const base = import.meta.env.BASE_URL;
const lang: "en" | "ja" = "ja";

const dataDir = path.resolve("./public/files/eigenfunctions/data");
const indexFile = JSON.parse(
  fs.readFileSync(path.join(dataDir, "index.json"), "utf-8")
) as { domains: any[] };

const domains = indexFile.domains.map((entry: any) => {
  const full = JSON.parse(
    fs.readFileSync(path.join(dataDir, `${entry.id}.json`), "utf-8")
  );
  return full;
});

const categoryLabel: Record<string, string> = {
  basic: "基本（変数分離）",
  polygon: "多角形",
  "non-convex": "非凸",
  chaotic: "カオス的ビリヤード",
  curved: "曲線境界",
  sector: "扇形",
  collapsing: "細領域",
  isospectral: "同スペクトル",
};

const categoryOrder = [
  "basic",
  "polygon",
  "non-convex",
  "curved",
  "sector",
  "chaotic",
  "collapsing",
];

const byCategory = new Map<string, any[]>();
for (const d of domains) {
  if (!byCategory.has(d.category)) byCategory.set(d.category, []);
  byCategory.get(d.category)!.push(d);
}

const fmt = (x: number) => {
  if (x === 0) return "0";
  if (Math.abs(x) < 0.001 || Math.abs(x) >= 100000) return x.toExponential(4);
  return x.toFixed(6);
};
---

<BaseLayout
  title="ラプラシアン固有関数図鑑"
  description="理論的に興味深い平面領域上のラプラシアンのディリクレ／ノイマン固有値・固有関数の数値図鑑。"
  lang={lang}
  homeLink={`${base}ja/`}
  homeLabel="プロフィール"
  blogLink={`${base}ja/blog/`}
  blogLabel="ブログ"
  eigLink={`${base}ja/eigenfunctions/`}
  eigLabel="固有関数図鑑"
  altLink={`${base}en/eigenfunctions/`}
  altLabel="English"
  currentSection="eig"
>
  <main class="main-panel">
    <h1>ラプラシアン固有関数図鑑</h1>
    <p class="muted">
      理論的に興味深い平面領域について、ディリクレ／ノイマン・ラプラシアンの
      低次固有値と固有関数を FEM で計算した図鑑。研究者向けリファレンスとして整備しています。
    </p>

    <div class="eig-method">
      <h2 class="section-heading">計算方法</h2>
      <p>
        ガレルキン有限要素法（非構造三角形メッシュ／gmsh 4、P<sub>2</sub> Lagrange 要素）で
        一般化対称固有値問題 K u = λ M u を ARPACK のシフト反転モード
        （scipy.sparse.linalg.eigsh）で解いています。正方形、円板、正三角形、直角二等辺三角形、
        長方形 2:1 については閉形式解が既知で、下の表では数値値と並べて相対誤差を示しています。
      </p>
      <p>
        滑らかな領域および凸多角形領域では低次モードは 6–7 桁、L 字領域のように
        凹角を持つ領域では凹角由来の特異性のため第 1 モードでおよそ 3 桁の精度です
        （参考：Fox–Henrici–Moler ベンチマーク λ<sub>1</sub> = 9.63972384…）。
      </p>
      <p class="muted">
        全データ: <a href={`${base}files/eigenfunctions/data/index.json`}>index.json</a> ／
        各領域: <code>{`/files/eigenfunctions/data/<id>.json`}</code>。
        計算コード: <a href="https://github.com/ryendo/ryendo.github.io/blob/main/scripts/compute_eigenfunctions.py"><code>scripts/compute_eigenfunctions.py</code></a>
      </p>
    </div>

    {categoryOrder
      .filter((c) => byCategory.has(c))
      .map((cat) => (
        <section class="eig-category">
          <h2 class="section-heading">{categoryLabel[cat] ?? cat}</h2>

          {byCategory.get(cat)!.map((d: any) => (
            <article class="eig-domain" id={d.id}>
              <header class="eig-domain-header">
                <h3>
                  {d.nameJa}
                  <span class="eig-slug">#{d.id}</span>
                </h3>
                <p class="eig-desc">{d.descriptionJa}</p>
                {d.reference && (
                  <p class="eig-ref"><strong>参考文献</strong> {d.reference}</p>
                )}
                <p class="eig-mesh muted">
                  メッシュ: {d.mesh.vertices.toLocaleString()} 頂点、
                  {d.mesh.triangles.toLocaleString()} 三角形、
                  {d.mesh.element}
                </p>
              </header>

              {(["dirichlet", "neumann"] as const).map((bc) => {
                const info = d.boundaries?.[bc];
                if (!info) return null;
                const modes = info.modes as any[];
                return (
                  <div class="eig-bc-block">
                    <h4>
                      {bc === "dirichlet" ? "ディリクレ" : "ノイマン"}境界条件
                    </h4>
                    <div class="eig-grid">
                      {modes.map((m: any) => (
                        <figure class="eig-mode">
                          <a href={m.image} target="_blank" rel="noreferrer">
                            <img
                              src={m.image}
                              alt={`${d.nameJa}, ${bc}, モード ${m.k}`}
                              loading="lazy"
                            />
                          </a>
                          <figcaption>
                            <span class="mode-k">k = {m.k}</span>
                            <span class="mode-lam">λ = {fmt(m.lambda)}</span>
                            {m.lambdaExact !== null && (
                              <span class="mode-exact muted">
                                厳密 {fmt(m.lambdaExact)}（相対誤差 {m.relErr.toExponential(1)}）
                              </span>
                            )}
                          </figcaption>
                        </figure>
                      ))}
                    </div>
                  </div>
                );
              })}
            </article>
          ))}
        </section>
      ))}
  </main>
</BaseLayout>

<style>
  .eig-method p { margin: 0.35em 0; }
  .eig-method code { background: #f3f3f3; padding: 0 0.2em; border-radius: 3px; font-size: 0.9em; }

  .eig-category { margin-top: 2em; }
  .eig-domain { margin: 1.2em 0 2.2em; padding: 1em 1.2em; border: 1px solid #e2e2e2; border-radius: 6px; background: #fcfcfc; }
  .eig-domain-header h3 { margin: 0 0 0.2em; font-size: 1.15em; }
  .eig-slug { margin-left: 0.5em; color: #888; font-size: 0.75em; font-weight: normal; font-family: ui-monospace, Menlo, monospace; }
  .eig-desc { margin: 0.3em 0 0.2em; color: #222; }
  .eig-ref { margin: 0.3em 0; font-size: 0.85em; color: #444; }
  .eig-mesh { margin: 0.2em 0 0; font-size: 0.82em; }

  .eig-bc-block { margin-top: 1em; }
  .eig-bc-block h4 { margin: 0.5em 0 0.4em; font-size: 0.95em; color: #333; font-weight: 600; }

  .eig-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.8em;
  }
  .eig-mode { margin: 0; display: flex; flex-direction: column; align-items: stretch; }
  .eig-mode img { width: 100%; height: auto; display: block; border: 1px solid #e0e0e0; border-radius: 3px; background: #fff; }
  .eig-mode figcaption { display: flex; flex-direction: column; font-size: 0.78em; line-height: 1.35; margin-top: 0.25em; font-family: ui-monospace, Menlo, monospace; }
  .mode-k { color: #555; }
  .mode-lam { color: #000; }
  .mode-exact { font-size: 0.78em; }
</style>
