---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";

const base = import.meta.env.BASE_URL;

export const frontmatter = {
  title: "固有関数データベース (β版)",
  description:
    "平面領域上のラプラシアンの Dirichlet / Neumann / Robin / Steklov 固有値・固有関数の数値データベース。",
  date: "2026-04-15",
  lang: "ja",
};

const dataDir = path.resolve("./public/files/eigenfunctions/data");
let indexFile: { domains: any[]; individuals: any[]; families: any[] };
try {
  indexFile = JSON.parse(
    fs.readFileSync(path.join(dataDir, "index.json"), "utf-8")
  );
} catch {
  indexFile = { domains: [], individuals: [], families: [] };
}

const domainById = new Map<string, any>();
for (const entry of indexFile.domains) {
  try {
    const full = JSON.parse(fs.readFileSync(path.join(dataDir, `${entry.id}.json`), "utf-8"));
    domainById.set(entry.id, full);
  } catch {}
}
const individuals = indexFile.individuals.map((e) => domainById.get(e.id)).filter(Boolean);
const families = indexFile.families.map((fam) => ({
  ...fam,
  members: fam.memberIds.map((id: string) => domainById.get(id)).filter(Boolean),
}));
const totalDomains = individuals.length + families.reduce((acc, f) => acc + f.members.length, 0);

const categoryLabel: Record<string, string> = {
  basic: "基本",
  polygon: "多角形",
  "non-convex": "非凸",
  chaotic: "カオス的ビリヤード",
  curved: "曲線境界",
  sector: "扇形",
  collapsing: "細領域",
  isospectral: "同スペクトル",
};
const categoryOrder = ["basic", "polygon", "non-convex", "curved", "sector", "chaotic", "collapsing"];

const fmt = (x: number) => {
  if (x === 0) return "0";
  if (Math.abs(x) < 0.001 || Math.abs(x) >= 100000) return x.toExponential(4);
  return x.toFixed(6);
};

const indivByCat = new Map<string, any[]>();
for (const d of individuals) {
  if (!indivByCat.has(d.category)) indivByCat.set(d.category, []);
  indivByCat.get(d.category)!.push(d);
}
const famByCat = new Map<string, any[]>();
for (const f of families) {
  if (!famByCat.has(f.category)) famByCat.set(f.category, []);
  famByCat.get(f.category)!.push(f);
}

const blogLink = `${base}ja/blog/`;

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://ryendo.github.io";
const shareUrl = new URL(Astro.url.pathname, site).toString();
const shareText = `${frontmatter.title} — ${frontmatter.description}`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
const bskyUrl = `https://bsky.app/intent/compose?text=${encodeURIComponent(`${shareText} ${shareUrl}`)}`;
const mastodonUrl = `https://toot.kytta.dev/?text=${encodeURIComponent(`${shareText} ${shareUrl}`)}`;
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`;
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  lang="ja"
  homeLink={`${base}ja/`}
  homeLabel="プロフィール"
  blogLink={blogLink}
  blogLabel="ブログ"
  altLink={`${base}en/blog/eigenfunction-atlas/`}
  altLabel="English"
  currentSection="blog"
  ogImage="/files/eigenfunctions/og-cover.jpg"
  ogType="article"
  useKatex={true}
>
  <main class="main-panel">
    <p><a href={blogLink}>← ブログ一覧に戻る</a></p>

    <div class="article-header">
      <h1 class="article-title">{frontmatter.title}</h1>
      <div class="article-meta">{frontmatter.date} · {totalDomains} 領域</div>
    </div>

    <div class="article-content">
      <div class="eig-beta">
        <strong>Beta</strong>本データベースは β 版です。数値、領域の定義、
        参考文献、UI は今後変更する可能性があります。実際に利用される場合は
        対応する領域の JSON ファイルに対して照合し、差異があればご連絡ください。
      </div>

      <div class="eig-controls" id="eig-controls">
        <div class="eig-search-row">
          <input
            id="eig-search"
            type="search"
            placeholder="検索 — 例: 'スタジアム', 'L字', '菱形'…"
            autocomplete="off"
            spellcheck="false"
          />
          <span id="eig-count" class="muted"></span>
        </div>
        <div class="eig-bc-row">
          <label><input type="radio" name="eig-bc" value="dirichlet" checked /> Dirichlet</label>
          <label><input type="radio" name="eig-bc" value="neumann" /> Neumann</label>
          <label><input type="radio" name="eig-bc" value="robin" /> Robin (α=1)</label>
          <label><input type="radio" name="eig-bc" value="steklov" /> Steklov</label>
          <label><input type="radio" name="eig-bc" value="all" /> 全て</label>
        </div>
      </div>

      {/* INDIVIDUAL DOMAINS */}
      {categoryOrder.filter((c) => indivByCat.has(c)).map((cat) => (
        <section class="eig-category" data-cat={cat}>
          <h2 class="section-heading">{categoryLabel[cat] ?? cat} — 個別領域</h2>

          {indivByCat.get(cat)!.map((d: any) => (
            <article class="eig-domain" id={d.id}
              data-name={d.nameJa}
              data-haystack={`${d.id} ${d.nameEn} ${d.nameJa} ${d.descriptionJa} ${d.category}`.toLowerCase()}
            >
              <header class="eig-domain-header">
                <h3>{d.nameJa}<span class="eig-slug">#{d.id}</span></h3>
                <p class="eig-desc">{d.descriptionJa}</p>
                {d.reference && <p class="eig-ref"><strong>参考文献</strong> {d.reference}</p>}
                <p class="eig-mesh muted">
                  メッシュ: {d.mesh.vertices.toLocaleString()} 頂点、
                  {d.mesh.triangles.toLocaleString()} 三角形、
                  {d.mesh.element}
                </p>
              </header>

              {(["dirichlet", "neumann", "robin", "steklov"] as const).map((bc) => {
                const info = d.boundaries?.[bc];
                if (!info) return null;
                const hasAlpha = bc === "robin" && Array.isArray((info as any).entries);
                const entries = hasAlpha ? (info as any).entries : null;
                const alphas = hasAlpha ? (info as any).alphas : null;
                const defIdx = hasAlpha
                  ? Math.max(0, (alphas as number[]).findIndex((a: number) => Math.abs(a - 1.0) < 1e-9))
                  : 0;
                const modes = (hasAlpha ? entries[defIdx].modes : info.modes) as any[];
                const bcLabel = ({ dirichlet: "Dirichlet", neumann: "Neumann", robin: "Robin", steklov: "Steklov" } as const)[bc];
                return (
                  <div class="eig-bc-block" data-bc={bc}>
                    <h4>{bcLabel} 境界条件</h4>
                    {hasAlpha && (
                      <div class="eig-alpha-slider">
                        <label><span class="eig-param-label">α = </span><output class="eig-alpha-value">{alphas[defIdx]}</output></label>
                        <input type="range" class="eig-alpha-range"
                          min="0" max={alphas.length - 1} step="1" value={defIdx} />
                        <span class="eig-alpha-count muted">{defIdx + 1} / {alphas.length}</span>
                        <script type="application/json" class="eig-alpha-payload"
                          set:html={JSON.stringify({ alphas, entries })} />
                      </div>
                    )}
                    <div class="eig-viewer">
                      <figure class="eig-focus">
                        <img class="eig-focus-img"
                          data-modes={JSON.stringify(modes.map((m) => m.image))}
                          src={modes[0].image}
                          alt={`${d.nameJa}, ${bc}, 選択モード`} />
                        <figcaption class="eig-focus-cap">
                          <span class="eig-focus-k">k = {modes[0].k}</span>
                          <span class="eig-focus-lam"
                            data-lams={JSON.stringify(modes.map((m) => m.lambda))}
                            data-exact={JSON.stringify(modes.map((m) => m.lambdaExact))}
                            data-err={JSON.stringify(modes.map((m) => m.relErr))}
                          >λ = {fmt(modes[0].lambda)}</span>
                        </figcaption>
                      </figure>
                      <div class="eig-mode-picker" role="tablist" aria-label="モード番号">
                        {modes.map((m: any, idx: number) => (
                          <button type="button"
                            class={"eig-mode-btn" + (idx === 0 ? " is-active" : "")}
                            data-idx={idx}
                            data-k={m.k}
                            title={`λ = ${fmt(m.lambda)}`}
                          >k={m.k}</button>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              })}
            </article>
          ))}
        </section>
      ))}

      {/* FAMILIES */}
      {categoryOrder.filter((c) => famByCat.has(c)).map((cat) => (
        <section class="eig-category" data-cat={cat}>
          <h2 class="section-heading">{categoryLabel[cat] ?? cat} — パラメトリック族</h2>

          {famByCat.get(cat)!.map((fam: any) => {
            const packMode = (mm: any) => ({
              k: mm.k, lambda: mm.lambda,
              lambdaExact: mm.lambdaExact, relErr: mm.relErr, image: mm.image,
            });
            const membersData = fam.members.map((m: any) => {
              const robinInfo = m.boundaries?.robin;
              const robinPayload = robinInfo
                ? (Array.isArray(robinInfo.entries)
                    ? {
                        alphas: robinInfo.alphas,
                        entries: robinInfo.entries.map((e: any) => ({
                          alpha: e.alpha, modes: (e.modes ?? []).map(packMode),
                        })),
                      }
                    : { alphas: [1.0], entries: [{ alpha: 1.0, modes: (robinInfo.modes ?? []).map(packMode) }] })
                : null;
              return {
                id: m.id,
                param: m.familyParam,
                boundaries: {
                  dirichlet: (m.boundaries?.dirichlet?.modes ?? []).map(packMode),
                  neumann:   (m.boundaries?.neumann?.modes   ?? []).map(packMode),
                  robin:     robinPayload,
                  steklov:   (m.boundaries?.steklov?.modes   ?? []).map(packMode),
                },
                mesh: m.mesh,
              };
            });
            const haystack = `${fam.id} ${fam.nameEn} ${fam.nameJa} ${fam.descriptionJa} ${fam.category} ${fam.members.map((m: any) => m.id).join(" ")}`.toLowerCase();

            return (
              <article class="eig-domain eig-family" id={fam.id}
                data-family-id={fam.id}
                data-name={fam.nameJa}
                data-haystack={haystack}
              >
                <header class="eig-domain-header">
                  <h3>{fam.nameJa}<span class="eig-slug">#{fam.id}</span></h3>
                  <p class="eig-desc">{fam.descriptionJa}</p>
                  {fam.reference && <p class="eig-ref"><strong>参考文献</strong> {fam.reference}</p>}
                </header>

                <div class="eig-family-slider">
                  <label>
                    <span class="eig-param-label">{fam.paramJa ?? fam.param} = </span>
                    <output class="eig-param-value">{fam.paramValues[0]}</output>
                  </label>
                  <input type="range" class="eig-param-range"
                    min="0" max={fam.paramValues.length - 1} step="1" value="0" />
                  <span class="eig-param-count muted">1 / {fam.paramValues.length}</span>
                </div>

                <script type="application/json" class="eig-family-payload"
                  set:html={JSON.stringify({ paramValues: fam.paramValues, paramLabel: fam.paramJa ?? fam.param, members: membersData })} />

                <div class="eig-family-view">
                  <p class="eig-mesh muted" data-role="mesh-info"></p>
                  {(["dirichlet", "neumann", "robin", "steklov"] as const).map((bc) => {
                    const bcLabel = ({ dirichlet: "Dirichlet", neumann: "Neumann", robin: "Robin", steklov: "Steklov" } as const)[bc];
                    return (
                      <div class="eig-bc-block" data-bc={bc}>
                        <h4>{bcLabel} 境界条件</h4>
                        {bc === "robin" && (
                          <div class="eig-alpha-slider">
                            <label><span class="eig-param-label">α = </span><output class="eig-alpha-value">1</output></label>
                            <input type="range" class="eig-alpha-range" min="0" max="0" step="1" value="0" />
                            <span class="eig-alpha-count muted">1 / 1</span>
                          </div>
                        )}
                        <div class="eig-viewer" data-family-viewer={bc}>
                          <figure class="eig-focus">
                            <img class="eig-focus-img" alt={`${fam.nameJa}, ${bc}, 選択モード`} loading="lazy" />
                            <figcaption class="eig-focus-cap">
                              <span class="eig-focus-k">k = 1</span>
                              <span class="eig-focus-lam">λ = —</span>
                            </figcaption>
                          </figure>
                          <div class="eig-mode-picker" role="tablist" aria-label="モード番号"></div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </article>
            );
          })}
        </section>
      ))}
    </div>

    <div class="share-row">
      <span class="share-label">シェア</span>
      <a class="share-btn" href={xUrl} target="_blank" rel="noreferrer">X</a>
      <a class="share-btn" href={bskyUrl} target="_blank" rel="noreferrer">Bluesky</a>
      <a class="share-btn" href={mastodonUrl} target="_blank" rel="noreferrer">Mastodon</a>
      <a class="share-btn" href={linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="share-btn" href={facebookUrl} target="_blank" rel="noreferrer">Facebook</a>
      <button class="share-btn" type="button" data-copy={shareUrl} onclick="(async()=>{try{await navigator.clipboard.writeText(this.dataset.copy);this.textContent='✓';setTimeout(()=>{this.textContent='URL'},1200);}catch(e){}})()">URL</button>
    </div>
  </main>
</BaseLayout>

<script is:inline>
(() => {
  const fmt = (x) => {
    if (x === 0) return "0";
    if (Math.abs(x) < 0.001 || Math.abs(x) >= 100000) return x.toExponential(4);
    return x.toFixed(6);
  };
  const fmtErr = (x) => (x === null || x === undefined) ? null : Number(x).toExponential(1);

  const familyState = new WeakMap();

  const populateModes = (viewer, modes, selectedIdx, card, bcForState) => {
    const img = viewer.querySelector(".eig-focus-img");
    const kCap = viewer.querySelector(".eig-focus-k");
    const lamCap = viewer.querySelector(".eig-focus-lam");
    const picker = viewer.querySelector(".eig-mode-picker");
    if (!img || !lamCap) return;
    let idx = Math.max(0, Math.min(selectedIdx ?? 0, modes.length - 1));
    img.src = modes[idx].image;
    kCap.textContent = `k = ${modes[idx].k}`;
    let text = `λ = ${fmt(modes[idx].lambda)}`;
    if (modes[idx].lambdaExact !== null && modes[idx].lambdaExact !== undefined) {
      const e = fmtErr(modes[idx].relErr);
      text += e ? `  (厳密 ${fmt(modes[idx].lambdaExact)}, 相対誤差 ${e})` : `  (厳密 ${fmt(modes[idx].lambdaExact)})`;
    }
    lamCap.textContent = text;
    img.dataset.modes = JSON.stringify(modes.map((m) => m.image));
    lamCap.dataset.lams = JSON.stringify(modes.map((m) => m.lambda));
    lamCap.dataset.exact = JSON.stringify(modes.map((m) => m.lambdaExact));
    lamCap.dataset.err = JSON.stringify(modes.map((m) => m.relErr));
    picker.innerHTML = "";
    modes.forEach((m, i) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "eig-mode-btn" + (i === idx ? " is-active" : "");
      btn.dataset.idx = String(i);
      btn.dataset.k = String(m.k);
      btn.title = `λ = ${fmt(m.lambda)}`;
      btn.textContent = `k=${m.k}`;
      btn.addEventListener("click", () => {
        const imgEl = viewer.querySelector(".eig-focus-img");
        const images = JSON.parse(imgEl.dataset.modes || "[]");
        const lams = JSON.parse(lamCap.dataset.lams || "[]");
        const exacts = JSON.parse(lamCap.dataset.exact || "[]");
        const errs = JSON.parse(lamCap.dataset.err || "[]");
        imgEl.src = images[i];
        kCap.textContent = `k = ${m.k}`;
        let t = `λ = ${fmt(lams[i])}`;
        if (exacts[i] !== null && exacts[i] !== undefined) {
          const e = fmtErr(errs[i]);
          t += e ? `  (厳密 ${fmt(exacts[i])}, 相対誤差 ${e})` : `  (厳密 ${fmt(exacts[i])})`;
        }
        lamCap.textContent = t;
        viewer.querySelectorAll(".eig-mode-btn").forEach((b) => b.classList.toggle("is-active", b === btn));
        if (card && bcForState) {
          const s = familyState.get(card) || { selectedIdx: {} };
          s.selectedIdx[bcForState] = i;
          familyState.set(card, s);
        }
      });
      picker.appendChild(btn);
    });
  };

  const wireRobinAlpha = (bcBlock, payload, selectedK = 0, card = null) => {
    const slider = bcBlock.querySelector(".eig-alpha-range");
    if (!slider || !payload || !payload.alphas || !payload.entries) return;
    const valueOut = bcBlock.querySelector(".eig-alpha-value");
    const countOut = bcBlock.querySelector(".eig-alpha-count");
    const viewer = bcBlock.querySelector(".eig-viewer");
    const alphas = payload.alphas;
    const entries = payload.entries;
    slider.max = String(alphas.length - 1);
    let idx = alphas.findIndex((a) => Math.abs(a - 1.0) < 1e-9);
    if (idx < 0) idx = 0;
    slider.value = String(idx);
    const update = () => {
      const i = Number(slider.value);
      valueOut.textContent = alphas[i];
      if (countOut) countOut.textContent = `${i + 1} / ${alphas.length}`;
      const modes = entries[i].modes || [];
      if (!modes.length) { bcBlock.style.display = "none"; return; }
      bcBlock.style.display = "";
      populateModes(viewer, modes, selectedK, card, "robin");
    };
    slider.oninput = update;
    update();
  };

  // --- individual-domain Robin α sliders ---
  document.querySelectorAll('.eig-domain:not(.eig-family) .eig-bc-block[data-bc="robin"]').forEach((bcBlock) => {
    const payloadEl = bcBlock.querySelector(".eig-alpha-payload");
    if (!payloadEl) return;
    const payload = JSON.parse(payloadEl.textContent || "null");
    if (!payload) return;
    wireRobinAlpha(bcBlock, payload);
  });

  // --- individual-domain viewers (mode picker click handlers) ---
  document.querySelectorAll(".eig-domain:not(.eig-family) .eig-viewer").forEach((viewer) => {
    const img = viewer.querySelector(".eig-focus-img");
    const kCap = viewer.querySelector(".eig-focus-k");
    const lamCap = viewer.querySelector(".eig-focus-lam");
    if (!img || !lamCap) return;
    viewer.querySelectorAll(".eig-mode-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = Number(btn.dataset.idx);
        const images = JSON.parse(img.dataset.modes || "[]");
        const lams = JSON.parse(lamCap.dataset.lams || "[]");
        const exacts = JSON.parse(lamCap.dataset.exact || "[]");
        const errs = JSON.parse(lamCap.dataset.err || "[]");
        img.src = images[idx];
        kCap.textContent = `k = ${btn.dataset.k}`;
        let text = `λ = ${fmt(lams[idx])}`;
        if (exacts[idx] !== null && exacts[idx] !== undefined) {
          const e = fmtErr(errs[idx]);
          text += e ? `  (厳密 ${fmt(exacts[idx])}, 相対誤差 ${e})` : `  (厳密 ${fmt(exacts[idx])})`;
        }
        lamCap.textContent = text;
        viewer.querySelectorAll(".eig-mode-btn").forEach((b) => b.classList.toggle("is-active", b === btn));
      });
    });
    viewer.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const btns = Array.from(viewer.querySelectorAll(".eig-mode-btn"));
      const cur = btns.findIndex((b) => b.classList.contains("is-active"));
      const next = e.key === "ArrowRight"
        ? Math.min(cur + 1, btns.length - 1)
        : Math.max(cur - 1, 0);
      btns[next].click(); btns[next].focus(); e.preventDefault();
    });
  });

  const renderFamilyBC = (card, bcBlock, member, bc) => {
    const viewer = bcBlock.querySelector(".eig-viewer");
    if (!viewer) return;
    if (bc === "robin") {
      const payload = member.boundaries?.robin;
      if (!payload || !payload.entries || !payload.entries.length) {
        bcBlock.style.display = "none"; return;
      }
      bcBlock.style.display = "";
      const st = familyState.get(card) || { selectedIdx: {} };
      wireRobinAlpha(bcBlock, payload, st.selectedIdx[bc] ?? 0, card);
      return;
    }
    const modes = member.boundaries[bc] || [];
    if (!modes.length) { bcBlock.style.display = "none"; return; }
    bcBlock.style.display = "";
    const st = familyState.get(card) || { selectedIdx: {} };
    populateModes(viewer, modes, st.selectedIdx[bc] ?? 0, card, bc);
  };

  document.querySelectorAll(".eig-family").forEach((card) => {
    const payloadEl = card.querySelector(".eig-family-payload");
    if (!payloadEl) return;
    const payload = JSON.parse(payloadEl.textContent || "{}");
    const slider = card.querySelector(".eig-param-range");
    const valueOut = card.querySelector(".eig-param-value");
    const countOut = card.querySelector(".eig-param-count");
    const meshEl = card.querySelector('[data-role="mesh-info"]');
    familyState.set(card, { selectedIdx: {} });

    const render = () => {
      const idx = Number(slider.value);
      const member = payload.members[idx];
      const paramVal = payload.paramValues[idx];
      valueOut.textContent = typeof paramVal === "number" ? (paramVal.toString().length > 6 ? paramVal.toFixed(4) : paramVal) : paramVal;
      if (countOut) countOut.textContent = `${idx + 1} / ${payload.members.length}`;
      if (meshEl && member && member.mesh) {
        meshEl.textContent =
          `メッシュ: ${member.mesh.vertices.toLocaleString()} 頂点、${member.mesh.triangles.toLocaleString()} 三角形、${member.mesh.element}`;
      }
      if (!member) return;
      card.querySelectorAll(".eig-bc-block").forEach((bcBlock) => {
        const bc = bcBlock.getAttribute("data-bc");
        renderFamilyBC(card, bcBlock, member, bc);
      });
    };
    slider.addEventListener("input", render);
    card.addEventListener("keydown", (e) => {
      if (e.target.classList.contains("eig-mode-btn")) return;
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const cur = Number(slider.value);
      const next = e.key === "ArrowRight"
        ? Math.min(cur + 1, payload.members.length - 1)
        : Math.max(cur - 1, 0);
      slider.value = String(next);
      render(); e.preventDefault();
    });
    render();
  });

  const applyBc = (val) => {
    document.querySelectorAll(".eig-bc-block").forEach((blk) => {
      const bc = blk.getAttribute("data-bc");
      blk.style.display = (val === "all" || bc === val) ? "" : "none";
    });
  };
  document.querySelectorAll('input[name="eig-bc"]').forEach((r) => {
    r.addEventListener("change", () => applyBc(r.value));
  });

  const search = document.getElementById("eig-search");
  const countEl = document.getElementById("eig-count");
  const allCards = Array.from(document.querySelectorAll(".eig-domain"));
  const updateCount = (visible) => {
    if (countEl) countEl.textContent = `${visible} / ${allCards.length} 項目`;
  };
  const applySearch = (q) => {
    const needle = q.trim().toLowerCase();
    let visible = 0;
    allCards.forEach((c) => {
      const hay = c.dataset.haystack || "";
      const match = !needle || hay.includes(needle);
      c.style.display = match ? "" : "none";
      if (match) visible++;
    });
    document.querySelectorAll(".eig-category").forEach((sec) => {
      const anyVisible = Array.from(sec.querySelectorAll(".eig-domain")).some((c) => c.style.display !== "none");
      sec.style.display = anyVisible ? "" : "none";
    });
    updateCount(visible);
  };
  if (search) {
    search.addEventListener("input", (e) => applySearch(e.target.value));
    document.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement !== search && !e.metaKey && !e.ctrlKey && !e.altKey) {
        search.focus(); e.preventDefault();
      }
    });
  }
  updateCount(allCards.length);
})();
</script>

