---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="ブログ | 遠藤凌輝"
  description="遠藤凌輝のブログ"
  lang="ja"
  homeLink={`${base}ja/`}
  homeLabel="プロフィール"
  blogLink={`${base}ja/blog/`}
  blogLabel="ブログ"
  altLink={`${base}en/blog/`}
  altLabel="English"
  currentSection="blog"
>
  <main class="main-panel">
    <section class="section-card">
      <h1 class="section-title">ブログ</h1>
      <p>研究の更新、短いメモ、告知、セミナーや出張の記録を書く場所です。</p>

      <div class="card-list" style="margin-top: 1rem;">
        <a href={`${base}ja/blog/first-post/`}>
          <article class="item-card">
            <h3>最初の記事</h3>
            <p>これはサンプル記事です。あとで自分の記事に置き換えてください。</p>
          </article>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>