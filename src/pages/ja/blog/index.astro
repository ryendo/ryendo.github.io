---
import BaseLayout from "../../../layouts/BaseLayout.astro";

type Post = {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    date: string;
  };
};

const base = import.meta.env.BASE_URL;
const homeLink = `${base}ja/`;
const blogLink = `${base}ja/blog/`;
const altLink = `${base}en/blog/`;

const posts = ((await Astro.glob("./*.md")) as Post[]).sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime()
);
---

<BaseLayout
  title="ブログ"
  description="研究の更新、短いメモ、告知、セミナーや出張の記録"
  lang="ja"
  homeLink={homeLink}
  homeLabel="Home"
  blogLink={blogLink}
  blogLabel="Blog"
  altLink={altLink}
  currentSection="blog"
>
  <h1>ブログ</h1>

  <p>研究の更新、短いメモ、告知、セミナーや出張の記録を書く場所です。</p>

  <ul>
    {posts.map((post) => (
      <li>
        <a href={post.url}>{post.frontmatter.title}</a>
        {" — "}
        {post.frontmatter.description}
        {" ("}
        {post.frontmatter.date}
        {")"}
      </li>
    ))}
  </ul>
</BaseLayout>