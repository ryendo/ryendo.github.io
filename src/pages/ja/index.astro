---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profileJa, siteInfo } from "../../data/profile";

const profile = profileJa;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="遠藤 凌輝 | Ryoki Endo"
  description=""
  lang="ja"
  homeLink={`${base}ja/`}
  homeLabel="プロフィール"
  blogLink={`${base}ja/blog/`}
  blogLabel="ブログ"
  eigLink={`${base}ja/eigenfunctions/`}
  eigLabel="固有関数図鑑"
  altLink={`${base}en/`}
  altLabel="English"
  currentSection="home"
>
  <main class="main-panel">
    <h1 class="profile-name">{profile.heroTitle}</h1>

    <div class="profile-bio">
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="profile-meta">
      <span>{siteInfo.emailDisplay}</span>
      <a href={siteInfo.researchmap} target="_blank" rel="noreferrer">researchmap</a>
      <a href={siteInfo.orcid} target="_blank" rel="noreferrer">ORCID</a>
    </div>

    <div class="section">
      <h2 class="section-heading">研究キーワード</h2>
      <div class="keywords">
        {profile.keywords.map((keyword) => (
          <span class="keyword">{keyword}</span>
        ))}
      </div>
    </div>

    <div class="section">
      <h2 class="section-heading">学位</h2>
      <ul class="simple-list">
        {profile.degrees.map((item) => (
          <li>
            <span class="label">{item.ja}</span>
            <span class="meta">{item.when}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">論文</h2>
      <ul class="pub-list">
        {profile.publications.map((paper) => (
          <li class="pub-item">
            <div class="pub-title">{paper.title}</div>
            <div class="pub-authors">{paper.authors}</div>
            <div class="pub-venue">{paper.venue}</div>
            <div class="pub-meta">
              <span class="date">{paper.when}</span>
              <span class="badge">{paper.note}</span>
              {(paper.arxivUrl || paper.journalUrl) && (
                <span class="pub-links">
                  {paper.arxivUrl && <a href={paper.arxivUrl} target="_blank" rel="noreferrer">arXiv</a>}
                  {paper.journalUrl && <a href={paper.journalUrl} target="_blank" rel="noreferrer">Journal</a>}
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">受賞</h2>
      <ul class="simple-list">
        {profile.awards.map((item) => (
          <li>
            <span class="label">{item.label}</span>
            <span class="meta">{item.year}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">日本語の講演</h2>
      <ul class="talk-list">
        {profile.talksJapanese.map((talk) => (
          <li class="talk-item">
            <div class="talk-title">{talk.title}</div>
            <div class="talk-detail">
              {talk.event}, {talk.date}{talk.note ? ` (${talk.note})` : ""}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">英語の講演</h2>
      <ul class="talk-list">
        {profile.talksEnglish.map((talk) => (
          <li class="talk-item">
            <div class="talk-title">{talk.title}</div>
            <div class="talk-detail">
              {talk.event}, {talk.date}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">所属学協会</h2>
      <ul class="simple-list">
        {profile.memberships.map((item) => (
          <li>
            <span class="label">{item.ja}</span>
            <span class="meta">{item.period}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="section">
      <h2 class="section-heading">共同研究・競争的資金等の研究課題</h2>
      <ul class="simple-list">
        {profile.grants.map((item) => (
          <li>
            <span class="label">{item.ja}</span>
            <span class="meta">{item.funding}</span>
            <span class="meta">{item.period}</span>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
