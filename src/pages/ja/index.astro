---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profileJa, siteInfo } from "../../data/profile";

const profile = profileJa;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="遠藤 凌輝 | Ryoki Endo"
  description=""
  lang="ja"
  homeLink={`${base}ja/`}
  homeLabel="プロフィール"
  blogLink={`${base}ja/blog/`}
  blogLabel="ブログ"
  altLink={`${base}en/`}
  altLabel="English"
  currentSection="home"
>
  <main class="main-panel">
    <section class="section-card">
      <h1 class="hero-title">{profile.heroTitle}</h1>
      {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      <div class="info-list" style="margin-top: 1rem;">
        <div class="info-item">
          <div class="info-item-title">連絡先</div>
          <div class="info-item-meta">{siteInfo.emailDisplay}</div>
        </div>
        <div class="info-item">
          <div class="info-item-title">リンク</div>
          <a href={siteInfo.researchmap} target="_blank" rel="noreferrer">
            researchmap
          </a>
          <a href={siteInfo.orcid} target="_blank" rel="noreferrer">
            ORCID
          </a>
        </div>
      </div>      
    </section>

    <div class="profile-layout" style="margin-top: 1.2rem;">
      <aside class="profile-sidebar">
        <div class="profile-sidebar-card">
          <h2 class="profile-sidebar-title">目次</h2>
          <nav class="section-nav" aria-label="ページ内リンク">
            <a href="#keywords">研究キーワード</a>
            <a href="#degrees">学位</a>
            <a href="#papers">論文</a>
            <a href="#awards">受賞</a>            
            <a href="#talks-ja">日本語の講演</a>
            <a href="#talks-en">英語の講演</a>
            <a href="#societies">所属学協会</a>
            <a href="#grants">共同研究・競争的資金等の研究課題</a>            
          </nav>
        </div>
      </aside>

      <div class="profile-main">
        <div class="section-stack">

          <section id="keywords" class="section-card anchor-offset">
            <h2 class="section-title">研究キーワード</h2>
            <div class="hero-meta">
              {profile.keywords.map((keyword) => (
                <span class="tag">{keyword}</span>
              ))}
            </div>
          </section>

          <section id="degrees" class="section-card anchor-offset">
            <h2 class="section-title">学位</h2>
            <div class="info-list">
              {profile.degrees.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.ja}</div>
                  <div class="info-item-meta">{item.when}</div>
                </div>
              ))}
            </div>
          </section>


          <section id="papers" class="section-card anchor-offset">
            <h2 class="section-title">論文</h2>
            <div class="card-list">
              {profile.publications.map((paper) => (
                <article class="item-card">
                  <h3>{paper.title}</h3>
                  <p>{paper.authors}</p>
                  <p class="muted">{paper.venue}</p>

                  <div class="hero-meta" style="margin-top: 0.8rem;">
                    <span class="meta-chip">{paper.when}</span>
                    <span class="meta-chip">{paper.note}</span>
                  </div>

                  {(paper.arxivUrl || paper.journalUrl) && (
                    <div class="publication-links">
                      {paper.arxivUrl && (
                        <a
                          class="publication-link"
                          href={paper.arxivUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          arXiv
                        </a>
                      )}

                      {paper.journalUrl && (
                        <a
                          class="publication-link"
                          href={paper.journalUrl}
                          target="_blank"
                          rel="noreferrer"
                        >
                          Journal
                        </a>
                      )}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>

          <section id="awards" class="section-card anchor-offset">
            <h2 class="section-title">受賞</h2>
            <div class="info-list">
              {profile.awards.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.label}</div>
                  <div class="info-item-meta">{item.year}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="talks-ja" class="section-card anchor-offset">
            <h2 class="section-title">日本語の講演</h2>
            <div class="card-list">
              {profile.talksJapanese.map((talk) => (
                <article class="item-card">
                  <h3>{talk.title}</h3>
                  {talk.authors && <p>発表者: {talk.authors}</p>}
                  <p>{talk.event}</p>
                  <p class="muted">
                    {talk.date}
                    {talk.note ? ` · ${talk.note}` : ""}
                  </p>
                </article>
              ))}
            </div>
          </section>

          <section id="talks-en" class="section-card anchor-offset">
            <h2 class="section-title">英語の講演</h2>
            <div class="card-list">
              {profile.talksEnglish.map((talk) => (
                <article class="item-card">
                  <h3>{talk.title}</h3>
                  {talk.authors && <p>Speaker(s): {talk.authors}</p>}
                  <p>{talk.event}</p>
                  <p class="muted">{talk.date}</p>
                </article>
              ))}
            </div>
          </section>

          <section id="societies" class="section-card anchor-offset">
            <h2 class="section-title">所属学協会</h2>
            <div class="info-list">
              {profile.memberships.map((item) => (
                <div class="info-item">
                  <div class="info-item-title">{item.ja}</div>
                  <div class="info-item-meta">{item.period}</div>
                </div>
              ))}
            </div>
          </section>

          <section id="grants" class="section-card anchor-offset">
            <h2 class="section-title">共同研究・競争的資金等の研究課題</h2>
            <div class="card-list">
              {profile.grants.map((item) => (
                <article class="item-card">
                  <h3>{item.ja}</h3>
                  <p>{item.funding}</p>
                  <p class="muted">{item.period}</p>
                </article>
              ))}
            </div>
          </section>          
        </div>
      </div>
    </div>
  </main>
</BaseLayout>